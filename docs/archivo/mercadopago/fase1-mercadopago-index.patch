+// ============================================================
+// MERCADOPAGO — Checkout Pro real (vía Edge Functions de Supabase)
+// Ver docs/FASE-1-PAGOS-MERCADOPAGO.md
+// ============================================================
+async function startMercadoPagoCheckout(customer) {
+  if (SUPABASE_URL === 'YOUR_SUPABASE_URL') {
+    return showToast('MercadoPago aún no está configurado (ver docs/FASE-1-PAGOS-MERCADOPAGO.md)', 'warn');
+  }
+  const btn = document.querySelector('#checkout-content button[onclick^="submitOrder"]');
+  const label = btn ? btn.textContent : '';
+  if (btn) { btn.disabled = true; btn.textContent = 'Redirigiendo a MercadoPago…'; }
+  try {
+    const res = await fetch(`${FUNCTIONS_BASE}/mp-create-preference`, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
+        'apikey': SUPABASE_ANON_KEY
+      },
+      body: JSON.stringify({
+        items: state.cart.map(i => ({ id: i.id, qty: i.qty })),
+        customer,
+        origin: window.location.origin + window.location.pathname
+      })
+    });
+    const data = await res.json();
+    if (!res.ok || !data.init_point) throw new Error(data.error || 'No se pudo iniciar el pago');
+    sessionStorage.setItem('pk_mp_order', data.orderId);
+    window.location.href = data.init_point;
+  } catch (e) {
+    console.error(e);
+    showToast('MercadoPago: ' + e.message, 'error');
+    if (btn) { btn.disabled = false; btn.textContent = label || 'Confirmar Pedido 🚀'; }
+  }
+}
+
+function checkMercadoPagoReturn() {
+  const params = new URLSearchParams(window.location.search);
+  const mp = params.get('mp');
+  const orderId = params.get('order') || sessionStorage.getItem('pk_mp_order');
+  if (!mp || !orderId) return;
+  sessionStorage.removeItem('pk_mp_order');
+  history.replaceState({}, '', window.location.pathname);
+  state.cart = [];
+  updateCartUI();
+  showMercadoPagoResult(mp, orderId);
+}
+
+async function showMercadoPagoResult(mp, orderId) {
+  showModal('checkout-modal');
+  document.getElementById('checkout-content').innerHTML = `
+    <div style="text-align:center; padding:32px 0;">
+      <div class="spinner" style="margin:0 auto 18px; border-color:rgba(0,0,0,0.1); border-top-color:var(--blue);"></div>
+      <h2 style="font-size:22px; font-weight:900;">Verificando tu pago…</h2>
+      <p style="color:var(--text-sec); font-weight:600; margin-top:6px;">Pedido ${String(orderId).slice(0,8).toUpperCase()}</p>
+    </div>`;
+
+  let order = null;
+  if (sbClient && SUPABASE_URL !== 'YOUR_SUPABASE_URL') {
+    for (let i = 0; i < 20; i++) {
+      try {
+        const { data } = await sbClient.from('orders')
+          .select('payment_status,subtotal,currency,customer_name,mp_status_detail')
+          .eq('id', orderId).single();
+        if (data) { order = data; if (data.payment_status !== 'pending') break; }
+      } catch (e) {}
+      await new Promise(r => setTimeout(r, 2000));
+    }
+  }
+  renderMercadoPagoFinal(mp, orderId, order);
+}
+
+function renderMercadoPagoFinal(mp, orderId, order) {
+  const el = document.getElementById('checkout-content');
+  const ref = String(orderId).slice(0,8).toUpperCase();
+  const status = order?.payment_status || (mp === 'failure' ? 'rejected' : 'pending');
+  const total = order ? `$ ${Number(order.subtotal).toLocaleString()} ${order.currency || 'ARS'}` : '';
+  const firstName = order?.customer_name ? order.customer_name.split(' ')[0] : '';
+  const backBtn = `<button onclick="closeModal('checkout-modal')" class="w-full py-4 rounded-2xl font-black text-white text-lg" style="background:linear-gradient(135deg,#FF6B8A,#FF9F5B);">Seguir comprando →</button>`;
+
+  if (status === 'confirmed') {
+    el.innerHTML = `
+      <div style="text-align:center; padding:16px 0;">
+        <div style="font-size:64px; margin-bottom:12px; animation:bounce 1s ease infinite;">🎉</div>
+        <h2 style="font-size:24px; font-weight:900;">¡Pago aprobado!</h2>
+        <p style="color:var(--text-sec); font-weight:600; margin:6px 0 20px;">Gracias por tu compra${firstName ? ', ' + firstName : ''} 💖</p>
+        <div style="background:#f9f9fb; border-radius:20px; padding:18px; text-align:left; margin-bottom:16px;">
+          <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
+            <span style="font-size:13px; font-weight:700; color:var(--text-sec);">Nro. Pedido</span>
+            <span style="font-size:13px; font-weight:900; font-family:monospace;">${ref}</span>
+          </div>
+          <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
+            <span style="font-size:13px; font-weight:700; color:var(--text-sec);">Método</span>
+            <span style="font-size:13px; font-weight:900;">MercadoPago 💳</span>
+          </div>
+          <div style="display:flex; justify-content:space-between; padding-top:10px; border-top:2px solid #e8e8ed; margin-top:6px;">
+            <span style="font-size:16px; font-weight:900;">TOTAL</span>
+            <span style="font-size:18px; font-weight:900; color:var(--accent);">${total}</span>
+          </div>
+        </div>
+        <div style="background:#e8f8f0; border-radius:16px; padding:14px; text-align:left; margin-bottom:16px;">
+          <p style="font-size:12px; font-weight:700; color:#1a7f3a;">Te contactaremos por WhatsApp/email para coordinar el envío. 🚚</p>
+        </div>
+        ${backBtn}
+      </div>`;
+  } else if (status === 'rejected') {
+    el.innerHTML = `
+      <div style="text-align:center; padding:16px 0;">
+        <div style="font-size:64px; margin-bottom:12px;">❌</div>
+        <h2 style="font-size:24px; font-weight:900;">El pago no se completó</h2>
+        <p style="color:var(--text-sec); font-weight:600; margin:6px 0 20px;">${order?.mp_status_detail ? 'Motivo: ' + order.mp_status_detail : 'MercadoPago rechazó o cancelaste el pago.'}</p>
+        <p style="font-size:13px; color:var(--text-sec); font-weight:600; margin-bottom:16px;">Tu carrito sigue disponible. Podés intentar de nuevo.</p>
+        ${backBtn}
+      </div>`;
+  } else {
+    el.innerHTML = `
+      <div style="text-align:center; padding:16px 0;">
+        <div style="font-size:64px; margin-bottom:12px;">⏳</div>
+        <h2 style="font-size:24px; font-weight:900;">Pago en revisión</h2>
+        <p style="color:var(--text-sec); font-weight:600; margin:6px 0 20px;">MercadoPago está procesando el pago del pedido ${ref}. Te avisaremos apenas se acredite.</p>
+        ${backBtn}
+      </div>`;
+  }
+}
 </script>
 
